# replace {SOME_DOMAIN}, {SOME_OTHER_DOMAIN} with the names of all your domains/subdomains for which the request should be redirected
# replace {TARGET_PORT} with the port to which the request should be redirected

server {
  include snippets/https-def.conf;

  server_name www.{SOME_DOMAIN} www.{SOME_OTHER_DOMAIN};

  ssl_certificate /var/www/ssl_certificates/www.{SOME_DOMAIN}/fullchain.pem;
  ssl_certificate_key /var/www/ssl_certificates/www.{SOME_DOMAIN}/privkey.pem;

  client_max_body_size 60M;

  location / {
        proxy_set_header        Host $host:$server_port;
        proxy_set_header        X-Real-IP $remote_addr;
        proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
        # proxy_set_header        X-Forwarded-Proto $scheme;

        # Fix the "It appears that your reverse proxy set up is broken" error.
        proxy_pass          http://host.docker.internal:{TARGET_PORT};
        proxy_read_timeout  900;

        proxy_redirect      http://host.docker.internal:{TARGET_PORT} http://$host;

        proxy_buffer_size   128k;
        proxy_buffers   4 256k;
        proxy_busy_buffers_size   256k;
  }
  access_log /var/log/nginx/access_www.{SOME_DOMAIN}.proxy.log;
  error_log /var/log/nginx/error_www.{SOME_DOMAIN}.proxy.log;
}

server {
  include snippets/https-def.conf;
  server_name {SOME_DOMAIN} *.{SOME_DOMAIN} {SOME_OTHER_DOMAIN} *.{SOME_OTHER_DOMAIN};
  ssl_certificate /var/www/ssl_certificates/www.{SOME_DOMAIN}/fullchain.pem;
  ssl_certificate_key /var/www/ssl_certificates/www.{SOME_DOMAIN}/privkey.pem;
  return  301 $scheme://www.$http_host$request_uri;
}