HTTP_PORT=80
HTTPS_PORT=443
NGINX_CONF_DIR=./config
NGINX_LOGS_DIR=./logs
WWW_SRC_DIR=./src
LETSENCRYPT_DIR=./letsencrypt/etc
CHALLENGE_DIR=./letsencrypt/data
SSL_CERTS_DIR=./ssl/certs
SSL_FALLBACK_CERTS_DIR=./ssl/fallback
WWW_PHP_FPM_SRC_DIR=./src/php-fpm

# Docker Compose profiles (uncomment 'dev' to automatically start development services, e.g. MailHog):
# COMPOSE_PROFILES=dev

OAUTH2_DIR=./oauth2
OAUTH2_PROXY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
OAUTH2_PROXY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
OAUTH2_PROXY_REDIRECT_URL=https://dbadmin.twoja-domena.com/oauth2/callback
# 32 random bytes, base64-encoded:
OAUTH2_PROXY_COOKIE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
